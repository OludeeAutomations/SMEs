{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/auth/confirm", "destination": "/index.html" },
    { "source": "/auth/reset-password", "destination": "/index.html" },
    { "source": "/auth/team-invite", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/auth/confirm",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    },
    {
      "source": "/auth/reset-password",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    },
    {
      "source": "/auth/team-invite",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }]
    }
  ]
}
